                        <foaf:givenName>Zhihang</foaf:givenName>
                    </foaf:Person>
                </rdf:li>
                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Ye</foaf:surname>
                        <foaf:givenName>Jieping</foaf:givenName>
                    </foaf:Person>
