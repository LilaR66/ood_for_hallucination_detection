&lt;p&gt;github: &lt;a href=&quot;https://github.com/HaiVyNGUYEN/ld_official/blob/master/&quot; rel=&quot;noopener noreferrer nofollow&quot;&gt;https://github.com/HaiVyNGUYEN/ld_official/blob/master/&lt;/a&gt;&lt;/p&gt;
&lt;/div&gt;</rdf:value>
    </bib:Memo>
