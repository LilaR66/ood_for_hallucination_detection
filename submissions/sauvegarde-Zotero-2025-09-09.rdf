                </rdf:li>
                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Soatto</foaf:surname>
                        <foaf:givenName>Stefano</foaf:givenName>
                    </foaf:Person>
                </rdf:li>
                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Marchi</foaf:surname>
