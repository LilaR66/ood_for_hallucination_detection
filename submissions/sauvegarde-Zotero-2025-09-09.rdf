                    </foaf:Person>
                </rdf:li>
                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Rvanova</foaf:surname>
                        <foaf:givenName>Lyudmila</foaf:givenName>
                    </foaf:Person>
