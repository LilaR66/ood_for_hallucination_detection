                    </foaf:Person>
                </rdf:li>
                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Wang</foaf:surname>
                        <foaf:givenName>Ziyuan</foaf:givenName>
                    </foaf:Person>
                </rdf:li>
