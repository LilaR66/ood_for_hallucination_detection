        <bib:authors>
            <rdf:Seq>
                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Chuang</foaf:surname>
                        <foaf:givenName>Yung-Sung</foaf:givenName>
                    </foaf:Person>
                </rdf:li>
                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Qiu</foaf:surname>
                        <foaf:givenName>Linlu</foaf:givenName>
                    </foaf:Person>
                </rdf:li>
                <rdf:li>
